# Example Environment Variables for ADB Pentest Dashboard

# Backend Configuration
# ---------------------
# Host for the ADB server (if not localhost)
# ADB_HOST=localhost

# Port for the ADB server
# ADB_PORT=5037

# Full path to the ADB private key file (e.g., /home/user/.android/adbkey)
# If not set, the backend might try to use default ADB key locations.
# ADB_KEYFILE_PATH=

# Path to a directory where pentest scripts or tools (like Nmap, tcpdump) are stored or can be executed from.
# This can be used by the backend to locate and run these tools.
PENTEST_SCRIPT_PATH=/usr/bin/

# API Rate Limiting
# -----------------
# Maximum number of requests allowed per windowMs per IP address.
# Helps protect the backend and the connected Android device from overload.
API_RATE_LIMIT_MAX_REQUESTS=100

# Time window in milliseconds for rate limiting.
# Example: 60000 for 1 minute (100 requests per minute per IP).
API_RATE_LIMIT_WINDOW_MS=60000

# WebSocket Server Configuration (if different from HTTP server)
# ------------------------------
# Example: WS_PORT=3001

# Frontend Configuration (typically built into static assets or set at build time)
# --------------------
# Base URL for the backend API (if served from a different domain/port than the frontend)
# VITE_API_BASE_URL=http://localhost:3000 # Example for Vite/React, adjust as needed

# General Application Settings
# ----------------------------
# Log level for the backend (e.g., 'info', 'debug', 'warn', 'error')
LOG_LEVEL=info
